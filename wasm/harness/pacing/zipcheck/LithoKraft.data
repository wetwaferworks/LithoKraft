02 19.479827880859375Q89.95965576171875 38.95965576171875 70.47982788085938 70.98260879516602Q51 103.00556182861328 51 141.43310546875V438.56689453125Q51 476.9944381713867 70.47982788085938 509.017391204834Q89.95965576171875 541.0403442382812 121.98260879516602 560.5201721191406Q154.00556182861328 580 192.43310546875 580H497.8641357421875Q537.3213380907403 580 569.235251755011 560.626594543457Q601.1491654192815 541.2531890869141 620.2975136178438 508.9641799926758Q639.4458618164062 476.6751708984375 639.4458618164062 438.56689453125V218.350341796875H193.44793701171875V148.244140625Q193.44793701171875 145.8662109375 195.15707397460938 144.15707397460938Q196.8662109375 142.44793701171875 199.244140625 142.44793701171875H639.4458618164062V0H192.43310546875ZM193.44793701171875 344.6220703125H496.84930419921875V431.755859375Q496.84930419921875 434.1337890625 495.1401672363281 435.8429260253906Q493.4310302734375 437.55206298828125 491.0531005859375 437.55206298828125H199.244140625Q196.8662109375 437.55206298828125 195.15707397460938 435.8429260253906Q193.44793701171875 434.1337890625 193.44793701171875 431.755859375Z" fill="#5B4BB0"/></svg>// lithokraft.materials â€” LithoKraft default PBR material definitions.
// FORMAT (JSON, full-line `//` comments allowed):
//   { "format": "lithokraft.materials/v1", "materials": [ <material>, ... ] }
//   <material> fields (all optional except "id"):
//     "id":               string ID, e.g. "lithokraft:iron". Mods use their own namespace.
//     "albedo":           [r, g, b] linear-space base colour (default [1,1,1]).
//     "albedo_texture":   texture/layer ref into the texture registry (default "": flat colour).
//     "roughness":        0 (mirror) .. 1 (fully diffuse), default 0.9.
//     "metalness":        0 (dielectric) .. 1 (metal), default 0.
//     "emissive":         [r, g, b] linear emission colour, default [0,0,0].
//     "emissive_intensity": emission multiplier, default 0 (no emission).
//     "ior":              index of refraction, default 1.5.
//     "alpha":            0..1 opacity, default 1 (opaque).
//     "transparency":     blend strategy when alpha < 1: "screendoor" (default),
//                        "alphablend", "weightedoit", "additive".
//   Duplicate "id" with identical params is idempotent; with different params the load fails.
{
  "format": "lithokraft.materials/v1",
  "materials": [
    { "id": "lithokraft:stone", "albedo": [0.50, 0.50, 0.52], "albedo_texture": "stone", "roughness": 0.95, "ior": 1.52 },
    { "id": "lithokraft:dirt", "albedo": [0.36, 0.24, 0.15], "albedo_texture": "dirt", "roughness": 1.0, "ior": 1.45 },
    { "id": "lithokraft:grass", "albedo": [0.25, 0.48, 0.20], "albedo_texture": "grass_top", "roughness": 0.95, "ior": 1.40 },
    { "id": "lithokraft:wood", "albedo": [0.55, 0.38, 0.22], "albedo_texture": "planks", "roughness": 0.85, "ior": 1.50 },
    { "id": "lithokraft:log", "albedo": [0.42, 0.30, 0.18], "albedo_texture": "log_side", "roughness": 0.90, "ior": 1.50 },
    { "id": "lithokraft:leaves", "albedo": [0.18, 0.38, 0.14], "albedo_texture": "leaves", "roughness": 1.0, "alpha": 0.85, "transparency": "screendoor", "ior": 1.35 },
    { "id": "lithokraft:sand", "albedo": [0.76, 0.68, 0.50], "albedo_texture": "sand", "roughness": 1.0, "ior": 1.55 },
    { "id": "lithokraft:glass", "albedo": [0.85, 0.95, 1.00], "roughness": 0.05, "alpha": 0.35, "transparency": "screendoor", "ior": 1.52 },
    { "id": "lithokraft:ice", "albedo": [0.65, 0.80, 0.95], "roughness": 0.15, "alpha": 0.55, "transparency": "alphablend", "ior": 1.31 },
    { "id": "lithokraft:water", "albedo": [0.15, 0.35, 0.75], "roughness": 0.05, "alpha": 0.70, "transparency": "alphablend", "ior": 1.33 },
    { "id": "lithokraft:lava", "albedo": [0.90, 0.30, 0.05], "roughness": 0.40, "emissive": [1.0, 0.35, 0.05], "emissive_intensity": 3.0, "ior": 1.40 },
    { "id": "lithokraft:torch", "albedo": [0.60, 0.45, 0.25], "roughness": 0.80, "emissive": [1.0, 0.62, 0.25], "emissive_intensity": 2.0, "ior": 1.45 },
    { "id": "lithokraft:iron", "albedo": [0.55, 0.58, 0.62], "albedo_texture": "iron_block", "roughness": 0.35, "metalness": 1.0, "ior": 2.50 },
    { "id": "lithokraft:copper", "albedo": [0.72, 0.42, 0.28], "albedo_texture": "copper_block", "roughness": 0.40, "metalness": 1.0, "ior": 2.40 },
    { "id": "lithokraft:gold", "albedo": [0.95, 0.72, 0.30], "albedo_texture": "gold_block", "roughness": 0.25, "metalness": 1.0, "ior": 2.60 },
    { "id": "lithokraft:obsidian", "albedo": [0.08, 0.07, 0.12], "albedo_texture": "obsidian", "roughness": 0.30, "metalness": 0.2, "ior": 1.60 }
  ]
}
{
 "name": "base",
 "note": "Engine base pack: built-in shaders. Art packs and mods stack above it (docs/RESOURCE_PACKS.md)."
}
#version 300 es
precision highp float;
precision highp int;
precision highp sampler2DArray;
precision highp sampler3D;
// Chunk shading: texture array, palette tints and masks (wire C4 ring, colour lamps, repeater
// pips, memory cells) and animated faces. Base pack shader; a pack may override it.
// The shading itself is shared with the Vulkan program: chunk_shading.glsl.
in vec3 vWorld; in vec3 vNormal; in float vAO; in vec2 vUV;
flat in int vLayer; flat in int vVal; flat in int vMode; flat in int vRot;
uniform sampler2DArray uTex; uniform sampler2D uPal;
uniform vec3 uCam; uniform vec3 uSky; uniform float uFogEnd; uniform float uTime; uniform int uDebug;
// Near-camera model dithering (JD 2026-10-13): enables the guarded block
// at the top of chunk_shading.glsl's main(); band = (near, far) blocks.
#define LITHO_MODEL_DITHER
uniform float uModelDither;     // 1 = on, 0 = off
uniform vec2 uModelDitherBand;  // (near, far) view depth in blocks
// Material bindings come from the block models (resources.json): layer / palette-row indices.
uniform int uTile;
uniform int uWirePal[2]; uniform int uRing[2];
uniform int uLampPal[3]; uniform int uLampMask[3]; uniform int uLampRim[3];
uniform int uRepMask; uniform int uMemMask;
// Animations (mode 10, value = animation index): frame sequence slice + frame time each.
const int MAX_ANIMS = 8;
uniform int uAnimStart[MAX_ANIMS]; uniform int uAnimLen[MAX_ANIMS]; uniform float uAnimMs[MAX_ANIMS];
uniform int uAnimSeq[64];
uniform int uDot[2]; uniform int uDigits;
uniform int uLeafGlow[4]; uniform int uTwinkle;
uniform int uTintMask[32];  // 2026-10-16 kShadeTraceTint mask layers  // 2026-10-16 crystal twinkle (kShadeLeaf)
out vec4 frag;
#include "chunk_shading.glsl"
#version 300 es
// Chunk vertices: 12-byte PackedVertex (see render/renderer.h). Base pack shader; packs may
// override it with assets/packs/<pack>/shaders/chunk.vert.
layout(location = 0) in uvec3 aPos;    // 1/16 block units, local to the sub-chunk
layout(location = 1) in uvec4 aInfo;   // u, v (1/16), face | ao<<3 | rot<<5, layer
layout(location = 2) in uvec2 aShade;  // value, mode
layout(location = 3) in uint aLayerHi;  // Cortana 2026-10-15 1628: CA-03 high layer byte (PackedVertex byte 15)
uniform mat4 uVP;
uniform vec3 uOffset;
uniform vec3 uCam;  // Cortana 2026-10-16: shared with chunk.frag (foliage LOD)
out vec3 vWorld; out vec3 vNormal; out float vAO; out vec2 vUV;
flat out int vLayer; flat out int vVal; flat out int vMode; flat out int vRot;
const vec3 N[6] = vec3[6](vec3(1,0,0), vec3(-1,0,0), vec3(0,1,0), vec3(0,-1,0), vec3(0,0,1), vec3(0,0,-1));
void main() {
  vWorld = vec3(aPos) / 16.0 + uOffset;
  vNormal = N[aInfo.z & 7u];
  vAO = float((aInfo.z >> 3u) & 3u) / 3.0;
  vRot = int((aInfo.z >> 5u) & 3u);
  vUV = vec2(aInfo.xy) / 16.0;
  vLayer = int(aInfo.w | (aLayerHi << 8u)); vVal = int(aShade.x); vMode = int(aShade.y & 63u);
  gl_Position = uVP * vec4(vWorld, 1.0);
  // Cortana 2026-10-16 (JD foliage LOD, renderer.h kShadeLod*): LOD-tagged quads draw by the
  // sub-chunk's horizontal centre distance; the other set collapses outside the clip volume.
  uint lod = aShade.y & 192u;
  if (lod != 0u) {
    vec2 c = uOffset.xz + vec2(8.0) - uCam.xz;
    bool far = dot(c, c) > 32.0 * 32.0;
    if ((lod == 64u && far) || (lod == 128u && !far)) gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
  }
}
#version 300 es
precision highp float;
precision highp int;
precision highp sampler2DArray;
precision highp sampler3D;
// Chunk PBR fragment program (PBR phase 2 - ACTIVE: built as "chunk_pbr" by the gl33
// backend. See pbr_shading.glsl for the full seam list and the exact BRDF formulas
// this mirrors.)
//
// Per-fragment: material-table lookup by compact ID, flood-fill irradiance for
// diffuse, K analytic lights for specular, emissive straight add.
//
// MATERIAL TABLE TRANSPORT: the GL 3.3 backend has no SSBOs (4.3+; the vendored
// loader is 3.3-only), so the documented 48-byte std430 rows travel in a buffer
// texture: row r, float k = texelFetch(uPbrMaterials, r * 12 + k). The indices below
// mirror render/pbr_gl_upload.h (kPbr*); a Vulkan backend would bind the same rows
// as a real std430 SSBO. Out-of-range IDs clamp to row 0 (the built-in default).
//
// TRANSPARENCY TIERS (uniform int uPbrTier; values match PbrTransparencyTier order):
//   0 Simple        - straight alpha output; the backend enables blending for the
//                     PBR draw. Opaque materials bypass (alpha == 1).
//   1 ScreenDoor    - full PBR + 4x4 Bayer discard for alpha < 1; no blending, no
//                     sorting (the binary mesher only emits opaque cubes today, so
//                     this is the honest default tier).
//   2 PbrReflections- PBR reflection + simple alpha transmission (backend blends).
//   3 TrueRefraction- real refraction: the backend draws the PBR meshes twice. Pass 0
//                     (uRefractionPass == 0) draws opaque fragments only, then copies
//                     the framebuffer to `uSceneColor`; pass 1 draws refractive
//                     fragments only, sampling the copy along the Snell ray with TIR
//                     handling (pbrRefractSample in pbr_shading.glsl). Opaque fragments
//                     shade exactly like the other tiers. The uniform name `uSceneColor`
//                     and the tier value 3 are the contract - do not renumber the tiers.
in vec3 vWorld; in vec3 vNormal; in vec3 vViewDir;
flat in uint vMaterialId;
flat in float vBlockLight; flat in float vSkyLight;
uniform samplerBuffer uPbrMaterials;  // 12 R32F texels per material (48-byte rows)
// K analytic lights from the LightCollector (game fills FrameParams::pbrLights per
// frame; the backend uploads them here). lightCount <= PBR_MAX_LIGHTS (8).
uniform vec4 uPbrLightPos[8];    // xyz = world pos, w = intensity (PBR_MAX_LIGHTS)
uniform vec3 uPbrLightColor[8];  // linear emission colour
uniform int uPbrLightCount;
uniform int uPbrTier;  // 0..3, see above
// Near-camera model dithering (JD 2026-10-13): same IGN screen-door fade
// as the classic program and the CPU path (render/model_dither.h).
uniform float uModelDither;     // 1 = on, 0 = off
uniform vec2 uModelDitherBand;  // (near, far) view depth in blocks
// Flood-fill ambient mode (JD-locked 2026-10-11, cvar `render.ambient_mode`):
// 0 = Fraction (cheap default), 1 = NormalizedSun (direction-aware hemisphere).
uniform int uAmbientMode;
uniform vec3 uSunDir;  // sun direction for the hemisphere term (need not be unit)
// PBR material table row count: pbrMaterialFromTbo clamps IDs into [0, rows),
// falling back to row 0 (fix 2026-10-11: min(id,0xffff) still read past the table
// for stale/foreign IDs from older registry generations).
uniform int uPbrMaterialRows;
// TrueRefraction (Ultra) scene-color pass: the backend binds the opaque composite
// (sRGB-encoded, mipmapped) as `uSceneColor` before the refractive pass. The uniform
// name `uSceneColor` is the phase-1 contract - kept verbatim.
uniform sampler2D uSceneColor;  // opaque composite for the refraction sample
uniform vec2 uSceneSize;        // copy resolution in pixels (for gl_FragCoord -> UV)
uniform mat4 uSceneVP;          // view-projection used when the copy was taken
uniform int uRefractionPass;    // 0 = scene build (opaque fragments only),
                                // 1 = refractive resolve (refractive fragments only)
out vec4 frag;
#include "pbr_shading.glsl"

// 4x4 Bayer matrix (same values and order as kBayer4x4 in transparency_method.h).
// Returns the discard threshold on the 0..255 scale the CPU screenDoorTest uses
// (matrix value * 17), so the GPU discard matches the CPU path exactly.
float pbrBayerThreshold(vec2 p) {
  const float m[16] = float[16](
       0.0,  8.0,  2.0, 10.0,
      12.0,  4.0, 14.0,  6.0,
       3.0, 11.0,  1.0,  9.0,
      15.0,  7.0, 13.0,  5.0);
  ivec2 ij = ivec2(int(mod(p.x, 4.0)), int(mod(p.y, 4.0)));
  return m[ij.y * 4 + ij.x] * 17.0;
}

PbrMaterial pbrMaterialFromTbo(uint id) {
  // Row 0 is the built-in default; out-of-range IDs (stale/foreign, e.g. from an
  // older registry generation) fall back to row 0 instead of reading OOB.
  // uPbrMaterialRows is the live table size (backend uploads it with the table).
  int rows = max(uPbrMaterialRows, 1);
  int r = id < uint(rows) ? int(id) : 0;
  int base = r * 12;
  PbrMaterial mat;
  mat.albedo = vec3(texelFetch(uPbrMaterials, base + 0).x,
                    texelFetch(uPbrMaterials, base + 1).x,
                    texelFetch(uPbrMaterials, base + 2).x);
  mat.roughness = texelFetch(uPbrMaterials, base + 3).x;
  mat.emissive = vec3(texelFetch(uPbrMaterials, base + 4).x,
                      texelFetch(uPbrMaterials, base + 5).x,
                      texelFetch(uPbrMaterials, base + 6).x);
  mat.emissiveIntensity = texelFetch(uPbrMaterials, base + 7).x;
  mat.metalness = texelFetch(uPbrMaterials, base + 8).x;
  mat.ior = texelFetch(uPbrMaterials, base + 9).x;
  mat.alpha = texelFetch(uPbrMaterials, base + 10).x;
  mat._pad = 0.0;
  return mat;
}

void main() {
  if (uModelDither > 0.5) {
    // vViewDir = uCam - vWorld (vertex stage), so its length is the
    // fragment's view depth in blocks.
    float ditherDist = length(vViewDir);
    float ditherFade = clamp((ditherDist - uModelDitherBand.x) /
                                 max(uModelDitherBand.y - uModelDitherBand.x, 0.0001),
                             0.0, 1.0);
    if (ditherFade < 1.0) {
      float ign = fract(52.9829189 * fract(0.06711056 * gl_FragCoord.x +
                                           0.00583715 * gl_FragCoord.y));
      if (ign >= ditherFade) discard;
    }
  }
  vec3 n = normalize(vNormal);
  vec3 v = normalize(vViewDir);
  PbrMaterial mat = pbrMaterialFromTbo(vMaterialId);
  vec3 linear = pbrShadeFragment(mat, n, v, vWorld,
                                 uPbrLightPos, uPbrLightColor, uPbrLightCount,
                                 vBlockLight, vSkyLight, uAmbientMode, uSunDir);
  float alpha = mat.alpha;
  if (uPbrTier == 1 && alpha < 1.0) {
    // ScreenDoor: ordered-dither discard, no blending, no sorting. The comparison
    // mirrors screenDoorTest exactly (alpha byte vs matrix*17).
    if (floor(alpha * 255.0) <= pbrBayerThreshold(gl_FragCoord.xy)) discard;
    alpha = 1.0;
  } else if (uPbrTier == 3) {
    // TrueRefraction (Ultra): two-pass scene-color refraction. Pass 0 keeps opaque
    // fragments only (they become the scene-color copy); pass 1 keeps refractive
    // fragments only and resolves them via the Snell-ray scene sample. Opaque
    // fragments shade exactly like the other tiers (linear already holds the PBR
    // shade); the refractive resolve outputs an opaque composite (no blending).
    if (uRefractionPass == 0) {
      if (alpha < 1.0) discard;
    } else {
      if (alpha >= 1.0) discard;
      linear = pbrRefractSample(mat, n, v, vWorld, uSceneVP,
                                uPbrLightPos, uPbrLightColor, uPbrLightCount,
                                uSceneColor, uSceneSize);
      alpha = 1.0;
    }
  }
  // Tier 0 (Simple) and 2 (PbrReflections): straight alpha; the backend enables
  // blending for the PBR draw on those tiers.
  frag = vec4(pbrLinearToSrgb(linear), alpha);
}
#version 300 es
// Chunk PBR vertex program (PBR phase 2 - ACTIVE: built as "chunk_pbr" by the gl33
// backend alongside the classic "chunk" program. Selection follows the meshes, not a
// mode flag: this program draws PbrChunkMesh uploads (the BinaryQuad path), the
// classic program draws PackedVertex uploads (see renderer.h).
//
// Vertex layout: PbrQuadVertex (render/pbr_quad_mesh.h), 20 bytes - the lean contract
// the BinaryQuad path can actually provide. aMaterial/aLight are flat per quad
// (merged quads share one material and one light level by construction).
layout(location = 0) in uvec3 aPos;      // 1/16 block units, local to the sub-chunk
layout(location = 1) in uint aFace;      // 0..5: +X,-X,+Y,-Y,+Z,-Z (== BinaryQuad::dir)
layout(location = 2) in uint aMaterial;  // compact MaterialRegistry ID (flat)
layout(location = 3) in uvec2 aLight;    // flood-fill block/sky level 0..64 (flat)
uniform mat4 uVP;
uniform vec3 uOffset;
uniform vec3 uCam;
out vec3 vWorld; out vec3 vNormal; out vec3 vViewDir;
flat out uint vMaterialId; flat out float vBlockLight; flat out float vSkyLight;
const vec3 N[6] = vec3[6](vec3(1,0,0), vec3(-1,0,0), vec3(0,1,0),
                          vec3(0,-1,0), vec3(0,0,1), vec3(0,0,-1));
void main() {
  vWorld = vec3(aPos) / 16.0 + uOffset;
  vNormal = N[aFace & 7u];
  vViewDir = uCam - vWorld;
  vMaterialId = aMaterial;
  vBlockLight = float(aLight.x);
  vSkyLight = float(aLight.y);
  gl_Position = uVP * vec4(vWorld, 1.0);
}
// Chunk shading shared by the OpenGL (chunk.frag) and Vulkan (vk/chunk.frag) programs.
// The including file declares the inputs (vWorld, vNormal, vAO, vUV, vLayer, vVal, vMode, vRot),
// the samplers uTex / uPal, the frame and material values (uCam, uSky, uFogEnd, uTime, uTile,
// uWirePal, uRing, uLampPal, uLampMask, uLampRim, uRepMask, uMemMask, uAnim*, MAX_ANIMS) and the
// output `frag`. Base pack file; a pack may override it (OpenGL only: Vulkan SPIR-V is built in).
//
// MODE NUMBERS - mirror litholattice::ShadeMode in renderer.h EXACTLY. Do not hardcode
// bare numbers below; use these constants. (Fix 2026-10-11: vMode==12 was the 7-segment
// branch while kShadeReadout=15, so the catchor readout never rendered.)
const int MODE_EMISSIVE = 1, MODE_CUTOUT = 2, MODE_WIRE0 = 3, MODE_WIRE1 = 4;
const int MODE_PIPS = 8, MODE_CELLS = 9, MODE_ANIMATED = 10, MODE_GLASS = 11, MODE_READOUT = 15;
const int MODE_ALPHABLEND = 12;  // Cortana 2026-10-15 1900: kShadeAlphaBlend (Elfie review LOW-1)
const int MODE_GROUND_PULSE = 16;  // mirror kShadeGroundPulse (renderer.h)
const int MODE_LEAF = 17;
const int MODE_TRACE_TINT = 18;  // mirror kShadeTraceTint (2026-10-16 Wafer beta art)  // mirror kShadeLeaf (2026-10-16 JD leaf pass): alpha test 0.5 + crystal twinkle
// ---- Wafer ground pulse (JD-locked 2026-10-11; biome blending 2026-10-11) ----
// The wafer's heartbeat: time-driven emissive add for kShadeGroundPulse quads.
// Pure function of (time, chunk, blended params): per-chunk phase from a hash of
// the chunk coords (cheap, no per-block timers); the waveform params are the
// chunk column's weight-blended biome params, baked at mesh time into the
// ChunkMesh and pushed per draw call (see render/ground_pulse.h). Dead-Zone-heavy
// blends carry ~zero amplitude, so the pulse fades out smoothly approaching Dead
// Zones instead of cutting off. CPU mirror: groundPulseEmissive(t, cx, cz, params)
// in render/ground_pulse.h (same waveform, same tunings - the tunings live ONLY
// in the C++ table; the shader evaluates whatever the mesh carries).
#ifndef LITHO_PULSE_PUSH
uniform vec4 uPulseP0;  // this chunk mesh: (freqHz, sharpness, amplitude, -)
uniform vec4 uPulseP1;  // this chunk mesh: (tint.rgb, -)
uniform float uGroundPulseTime;  // sim-time seconds (NOT wall clock: pausing freezes it)
uniform float uGroundPulseOn;    // render.ground_pulse cvar, 1 = on (live toggle, no remesh)
#endif
// Vulkan: uPulseP0/uPulseP1 come from the push-constant block and
// uGroundPulseTime/uGroundPulseOn from the Frame block; vk/chunk.frag defines
// LITHO_PULSE_PUSH and declares them, so the block above is skipped there.
vec3 groundPulseColor(float t, vec3 wpos) {
  if (uPulseP0.z <= 0.0) return vec3(0.0);  // unpowered blend: skip the math
  vec2 cc = floor(wpos.xz / 16.0);
  float ph = fract(sin(dot(cc, vec2(127.1, 311.7))) * 43758.5453123);
  float w = 0.5 + 0.5 * sin(6.28318530718 * (uPulseP0.x * t + ph));
  w = pow(w, uPulseP0.y);
  return uPulseP1.rgb * (uPulseP0.z * w);
}
// ---- Wafer ground traces (JD 2026-10-11; landed end-to-end 2026-10-13, P1-RENDER) ----
// GLSL mirror of groundTraceEmissive() in render/ground_traces.h: Manhattan
// trace lines with energy packets travelling along them, per-chunk blended
// params pushed per draw call like the pulse. Same shapes and tunings as the
// CPU mirror; only the per-line hash differs (classic sin-hash here, integer
// hash on CPU - cross-implementation line equality is not required, see the
// header). Composes additively with the pulse on kShadeGroundPulse quads.
#ifndef LITHO_TRACE_PUSH
uniform vec4 uTraceP0;  // this chunk mesh: (density, speed, amplitude, dirMix)
uniform vec4 uTraceP1;  // this chunk mesh: (tint.rgb, -)
uniform float uGroundTraceTime;  // sim-time seconds (same clock as the pulse)
uniform float uGroundTraceOn;    // render.ground_traces cvar, 1 = on (live toggle)
#endif
// Vulkan: uTraceP0/uTraceP1 come from the push-constant block and
// uGroundTraceTime/uGroundTraceOn from the Frame block; vk/chunk.frag defines
// LITHO_TRACE_PUSH and declares them, so the block above is skipped there.
// 0.0.1.52 [A52-1] (Proposed by Argon (Archie), Chief Optimization Officer and Chief Optimization Operand, the Bitmaster and the Bitmasker; Built by Cortana): screen-space footprint of world xz, set in main()
// (Vulkan FX with per-pixel lighting on); 0 elsewhere = the old fixed widths, bit-identical.
vec2 gTraceFw = vec2(0.0);
float groundTraceHash(float line, float seed) {
  return fract(sin(line * 374.761393 + seed * 668.265263) * 43758.5453123);
}
vec3 groundTraceColor(float t, vec3 wpos) {
  if (uTraceP0.z <= 0.0 || uTraceP0.x <= 0.0) return vec3(0.0);  // unpowered blend
  float density = uTraceP0.x, speed = uTraceP0.y, amp = uTraceP0.z, dirMix = uTraceP0.w;
  float pk = density * 0.25;  // packets per block along a line
  float hMix = 1.0 - dirMix, vMix = dirMix;
  // H-set: lines run along X at z = n / density.
  float zn = wpos.z * density;
  float lz = floor(zn);
  float fz = zn - lz;
  float h1 = groundTraceHash(lz, 1.0);
  float lineH = 0.35 + 0.65 * h1;
  float dl = min(fz, 1.0 - fz);
  // fwidth trace AA: the upper edge widens to ~1.25 px; the width ratio keeps each line's energy.
  vec2 fw = gTraceFw * density;  // x: V-set lines (x * density), y: H-set lines (z * density)
  float upH = max(0.08, 0.02 + fw.y * 1.25), upV = max(0.08, 0.02 + fw.x * 1.25);
  float wH = (1.0 - smoothstep(0.02, upH, dl)) * clamp(0.08 / upH, 0.25, 1.0);
  float sgnH = h1 < 0.5 ? 1.0 : -1.0;
  float puF = fract(sgnH * wpos.x * pk - t * speed + h1);
  float packH = smoothstep(0.0, 0.05, puF) * (1.0 - smoothstep(0.05, 0.28, puF));
  // V-set: lines run along Z at x = n / density.
  float xn = wpos.x * density;
  float lx = floor(xn);
  float fx = xn - lx;
  float h2 = groundTraceHash(lx, 2.0);
  float lineV = 0.35 + 0.65 * h2;
  float dv = min(fx, 1.0 - fx);
  float wV = (1.0 - smoothstep(0.02, upV, dv)) * clamp(0.08 / upV, 0.25, 1.0);
  float sgnV = h2 < 0.5 ? 1.0 : -1.0;
  float pvF = fract(sgnV * wpos.z * pk - t * speed + h2);
  float packV = smoothstep(0.0, 0.05, pvF) * (1.0 - smoothstep(0.05, 0.28, pvF));
  float lineGlow = hMix * wH * lineH + vMix * wV * lineV;
  float packGlow = hMix * wH * lineH * packH + vMix * wV * lineV * packV;
  float a = amp * (0.30 * lineGlow + 0.70 * packGlow);
  return uTraceP1.rgb * a;
}
const vec3 RING_BACK = vec3(22.0, 25.0, 34.0) / 255.0, RING_UNLIT = vec3(44.0, 50.0, 66.0) / 255.0;
const vec3 CORE[2] = vec3[2](vec3(1.0, 0.878, 0.722), vec3(0.867, 0.969, 1.0));
const vec3 RIM = vec3(185.0, 168.0, 240.0) / 255.0;
const vec3 PIP_LIT = vec3(255.0, 211.0, 107.0) / 255.0, CELL_LIT = vec3(143.0, 214.0, 232.0) / 255.0;
const vec3 CELL_OFF = vec3(30.0, 34.0, 48.0) / 255.0;
// Ginny 2026-10-16 (perf list, Cortana): greedy-merged quads on the GPU backends. A merged face
// carries tile UVs up to 15 (1/16-unit uint8); the block array sampler clamps, so the tile is
// repeated here. Components <= 1 pass through untouched (unmerged faces are bit-identical);
// beyond 1, an integer edge maps to 1 (not 0) so the far edge stays the tile's last texel.
// Sampling uses the derivatives of the RAW UV, so the wrap line never drops to a coarse mip.
vec2 lithoWrapUV(vec2 u) {
  return vec2(u.x > 1.0 ? u.x - min(floor(u.x), ceil(u.x) - 1.0) : u.x,
              u.y > 1.0 ? u.y - min(floor(u.y), ceil(u.y) - 1.0) : u.y);
}
vec2 gUVdx, gUVdy;  // raw-UV derivatives, set at the top of main()
vec4 lithoTex(vec2 uv, float layer) { return textureGrad(uTex, vec3(uv, layer), gUVdx, gUVdy); }
// 0.0.1.52 [A52-1] (Proposed by Argon (Archie), Chief Optimization Officer and Chief Optimization Operand, the Bitmaster and the Bitmasker; Built by Cortana): branchless quarter turns (selects, no loop)
vec2 rotUV(vec2 uv, int r) {   // same quarter turns as the mesher
  vec2 o = r == 1 ? vec2(uv.y, 1.0 - uv.x) : uv;
  o = r == 2 ? vec2(1.0) - uv : o;
  return r == 3 ? vec2(1.0 - uv.y, uv.x) : o;
}
int gRot;  // vRot & 3 (vk/chunk.vert packs the face index into bits 2..4)
vec4 mask(int layer, vec2 uv) {  // nearest fetch (masks store indices in R)
  ivec2 p = clamp(ivec2(uv * float(uTile)), ivec2(0), ivec2(uTile - 1));
  return texelFetch(uTex, ivec3(p, layer), 0);
}
#ifdef LITHO_VK_FX
// JD Vulkan push (Cortana 2026-10-16, clean-room): normal mapping without stored tangents (the first
// version used a screen-space cotangent frame; replaced by the face table below; credits in CHANGES.md).
// 0.0.1.52 [A52-1] (Proposed by Argon (Archie), Chief Optimization Officer and Chief Optimization Operand, the Bitmaster and the Bitmasker; Built by Cortana): faces are axis-aligned, so the tangent
// frame is a lookup by face index (packed in vRot bits 2..4): T = +u direction, B = -v direction
// of the unrotated tile (mesher faceUV), then the map's xy is turned back by the face rotation.
// No derivatives, no cross products, no seams on greedy-merged quads.
const vec3 FACE_T[6] = vec3[6](vec3(0, 0, -1), vec3(0, 0, 1), vec3(1, 0, 0), vec3(1, 0, 0), vec3(1, 0, 0), vec3(-1, 0, 0));
const vec3 FACE_B[6] = vec3[6](vec3(0, 1, 0), vec3(0, 1, 0), vec3(0, 0, -1), vec3(0, 0, 1), vec3(0, 1, 0), vec3(0, 1, 0));
vec3 lithoPerturbNormal(vec3 N, vec3 tn) {
  int f = min((vRot >> 2) & 7, 5);
  vec2 r = gRot == 1 ? vec2(tn.y, -tn.x) : tn.xy;
  r = gRot == 2 ? -tn.xy : r;
  r = gRot == 3 ? vec2(-tn.y, tn.x) : r;
  return normalize(FACE_T[f] * r.x + FACE_B[f] * r.y + N * tn.z);
}
// Grid vs Wafer palette (Argon brief), tunable constants only. The weights default to 0 so the
// CloudAtlas art look is unchanged; raise them to pull the look toward the brief.
const vec3 GRID_OBSIDIAN = vec3(0.020, 0.027, 0.039);  // #05070A
const vec3 WAFER_SILICON = vec3(0.055, 0.075, 0.122);  // #0E131F
const vec3 TRACE_RED = vec3(1.000, 0.118, 0.259);      // #FF1E42
const vec3 TRACE_BLUE = vec3(0.000, 0.898, 1.000);     // #00E5FF
const float WAFER_TINT = 0.0;   // 0..1: wafer ground texels toward WAFER_SILICON
const float TRACE_FADE = 0.0;   // per block: wafer trace glow fades exp(-d * k) (brief: 0.015)
const float PROC_GLOW_GAIN = 1.35;  // wafer trace energy into the bloom target
// 0.0.1.53 [C53-3] (Proposed by JD, Built by Cortana): the heartbeat has its own (tunable) bloom gain.
#ifndef HEARTBEAT_GLOW_GAIN
#define HEARTBEAT_GLOW_GAIN PROC_GLOW_GAIN
#endif
#endif
void main() {
  gUVdx = dFdx(vUV); gUVdy = dFdy(vUV);
  gRot = vRot & 3;
#ifdef LITHO_VK_FX
  // 0.0.1.52 [A52-1] (Proposed by Argon (Archie), Chief Optimization Officer and Chief Optimization Operand, the Bitmaster and the Bitmasker; Built by Cortana): gWdx/gWdy are gone (LUT normal mapping).
  if ((uFx.x & 2) != 0) gTraceFw = fwidth(vWorld.xz);  // uniform control flow (before any branch)
  fragGlow = vec4(0.0);
  // Blended bulb pass: alpha-blend faces draw only in the sorted blend pass (uPass 1).
  if ((uFx.x & 64) != 0 && ((uPass > 0.5) != (vMode == MODE_ALPHABLEND))) discard;
#endif
  vec2 uvW = lithoWrapUV(vUV);
#ifdef LITHO_MODEL_DITHER
  // Near-camera model dither fade (JD 2026-10-13): deterministic
  // interleaved-gradient-noise screen-door discard from the fragment's
  // view depth - the identical formula to the CPU path
  // (render/model_dither.h), so backends agree on the discard decision.
  // Only the GL includer defines LITHO_MODEL_DITHER + the uniforms; the
  // Vulkan includer does not (no band plumbing there yet).
  if (uModelDither > 0.5) {
    float ditherDist = length(uCam - vWorld);
    float ditherFade = clamp((ditherDist - uModelDitherBand.x) /
                                 max(uModelDitherBand.y - uModelDitherBand.x, 0.0001),
                             0.0, 1.0);
    if (ditherFade < 1.0) {
      float ign = fract(52.9829189 * fract(0.06711056 * gl_FragCoord.x +
                                           0.00583715 * gl_FragCoord.y));
      if (ign >= ditherFade) discard;
    }
  }
#endif
  vec3 n = vNormal;
  vec4 t = lithoTex(uvW, float(vLayer));
  vec3 base = t.rgb; float a = t.a; float emissive = 0.0;
  if (vMode == MODE_EMISSIVE) {
    emissive = 0.85;
  } else if (vMode == MODE_CUTOUT || vMode == MODE_LEAF) {
    if (a < 0.5) discard;
  } else if (vMode == MODE_TRACE_TINT) {  // grey mask (R) x feeding Trace colour, over the base
    float tm = mask(uTintMask[vVal & 31], uvW).r;
    bool on = (vVal & 128) != 0;
    vec3 tint = texelFetch(uPal, ivec2(on ? 64 : 0, uWirePal[(vVal >> 6) & 1]), 0).rgb;
    // 2026-10-16 (JD, Discovered by J.D.): grey until powered - no tint when off (was the ramp's red start).
    if (on) { base = mix(base, tint, tm); emissive = 0.85 * tm; }
  } else if (vMode == MODE_WIRE0 || vMode == MODE_WIRE1) {                       // wire
    int ch = vMode - MODE_WIRE0, s = clamp(vVal, 0, 64);
    float fs = float(s);
    float lum = max(t.r, max(t.g, t.b));
    vec3 ramp = texelFetch(uPal, ivec2(s, uWirePal[ch]), 0).rgb;
    vec3 col = mix(t.rgb, clamp(ramp * (lum / 0.85), 0.0, 1.0), smoothstep(0.45, 0.80, lum));
    col = mix(col, CORE[ch], 0.9 * smoothstep(0.90, 0.99, lum) * smoothstep(40.0, 64.0, fs));
    vec4 m = mask(uRing[ch], rotUV(uvW, (4 - gRot) & 3));   // ring mask uses the unrotated tile UV
    float idx = floor(m.r * 255.0 / 16.0 + 0.5);
    float level = clamp(fs - 4.0 * idx, 0.0, 4.0);
    float litA = level > 0.0 ? 0.25 + 0.75 * level / 4.0 : 0.0;
    vec3 rc = mix(mix(RING_BACK, RING_UNLIT, m.g), CORE[ch], m.g * litA);
    float ra = max(m.g, m.b);
    float A = ra + a * (1.0 - ra);
