# keys and secrets: never tracked
*-Key/
*-Keys/
*+Key*
*.key
signing*/
*.pem
*.pfx
*.p12
*.jks
*.keystore
.env
# art and big binaries: shared via folder, not git
/Assets/
*.rar
*.zip
*.mp4
*.7z
# nested repos keep their own history
Redstone-Trace-Translation/Advanced-Structure-Inspector/
# build output
build/
out/

# dependencies: restore with npm install
node_modules/

# Boardroom seat tokens (2026-10-22): never tracked
_private/

# Local edit backups (*.orig, *.orig2, *.orig-<date>-fixN); never commit them.
*.orig*

# Backup copies of reverted edits (2026-10-24): archived to %USERPROFILE%\WetWafer-backups\, never tracked
*.orig
*.reverted-*
*.spans-reverted-*
