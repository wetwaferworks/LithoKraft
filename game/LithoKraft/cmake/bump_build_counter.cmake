# 2026-10-23 (JD, fix run 2): LithoKraft's OWN rolling build counter. Runs on every build
# (custom target lk_build_counter, always out of date). COUNTER holds one plain decimal
# integer (1, 2, 3, ...), incremented by 1 per build. The public-facing label is read from
# VERSION_FILE (first line, e.g. "Alpha 0.0.1") and can be swapped independently of the
# number. This script never touches the engine's BUILD_COUNTER.txt (see docs/versioning/COUNTERS.md).
# Writes the generated header HEADER. Display/log only: never feeds the sim hash.
get_filename_component(_name "${COUNTER}" NAME)
string(TOLOWER "${_name}" _lname)
if(_lname STREQUAL "build_counter.txt")
  message(FATAL_ERROR "LithoKraft counter must not alias the engine counter BUILD_COUNTER.txt (case-insensitive): ${COUNTER}")
endif()
set(n 0)
if(EXISTS "${COUNTER}")
  file(STRINGS "${COUNTER}" _line LIMIT_COUNT 1)
  string(STRIP "${_line}" _line)
  if(_line MATCHES "^[0-9]+$")
    set(n "${_line}")
  else()
    message(FATAL_ERROR "LithoKraft counter ${COUNTER}: expected one decimal integer, got '${_line}'")
  endif()
endif()
# Hold rule (JD 2026-10-24): counters roll only for big repairs / new features. While
# <COUNTER>.hold exists next to the counter file, builds keep the current number.
if(NOT EXISTS "${COUNTER}.hold")
  math(EXPR n "${n} + 1")
endif()
set(_label "Alpha")
if(DEFINED VERSION_FILE AND EXISTS "${VERSION_FILE}")
  file(STRINGS "${VERSION_FILE}" _vl LIMIT_COUNT 1)
  string(STRIP "${_vl}" _vl)
  if(NOT _vl STREQUAL "")
    set(_label "${_vl}")
  endif()
endif()
string(REPLACE "\"" "" _label "${_label}")
# 2026-10-24 (JD): the same count as a four-place rolling counter "LithoKraft a.b.c.d", same
# rules as the engine's 8-place counter (wheels 0..63, carry left). Source of truth stays the
# decimal in COUNTER (the old "build N" 58 = 0.0.0.58).
math(EXPR _w3 "${n} % 64")
math(EXPR _w2 "(${n} / 64) % 64")
math(EXPR _w1 "(${n} / 4096) % 64")
math(EXPR _w0 "(${n} / 262144) % 64")
set(_counter "${_w0}.${_w1}.${_w2}.${_w3}")
file(WRITE "${COUNTER}.tmp" "${n}\n")
file(RENAME "${COUNTER}.tmp" "${COUNTER}")
file(WRITE "${HEADER}.tmp" "// Generated by game/LithoKraft/cmake/bump_build_counter.cmake on every build. Do not edit.\n#pragma once\n#define LITHOKRAFT_BUILD_NUMBER ${n}\n#define LITHOKRAFT_PUBLIC_VERSION \"${_label}\"\n#define LITHOKRAFT_ALPHA_VERSION \"${_label} build ${n}\"\n#define LITHOKRAFT_GAME_COUNTER \"${_counter}\"\n")
file(RENAME "${HEADER}.tmp" "${HEADER}")
message(STATUS "LithoKraft build counter: ${_label} build ${n} = LithoKraft ${_counter}")