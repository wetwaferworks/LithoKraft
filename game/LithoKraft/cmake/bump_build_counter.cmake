# 2026-10-16 (JD): runs on EVERY build (custom target lk_build_counter, always out of date).
# Bumps the tracked counter COUNTER (Alpha a.b.c.d): each field 0..63, d += 1, a field reaching 64
# resets to 0 and carries left (same rule as lithokraft/game/build_version.h, selftested there).
# Writes the generated header HEADER. The version is display/log only: it never feeds the sim hash.
if(EXISTS "${COUNTER}")
  file(STRINGS "${COUNTER}" _line LIMIT_COUNT 1)
else()
  set(_line "0.0.1.0")
endif()
string(STRIP "${_line}" _line)
string(REPLACE "." ";" _f "${_line}")
list(LENGTH _f _n)
if(NOT _n EQUAL 4)
  set(_f 0 0 1 0)
endif()
list(GET _f 0 a)
list(GET _f 1 b)
list(GET _f 2 c)
list(GET _f 3 d)
math(EXPR d "${d} + 1")
if(d GREATER_EQUAL 64)
  set(d 0)
  math(EXPR c "${c} + 1")
endif()
if(c GREATER_EQUAL 64)
  set(c 0)
  math(EXPR b "${b} + 1")
endif()
if(b GREATER_EQUAL 64)
  set(b 0)
  math(EXPR a "${a} + 1")
endif()
if(a GREATER_EQUAL 64)
  set(a 0)  # whole chain wrapped
endif()
set(_v "${a}.${b}.${c}.${d}")
file(WRITE "${COUNTER}" "${_v}\n")
file(WRITE "${HEADER}.tmp" "// Generated by game/LithoKraft/cmake/bump_build_counter.cmake on every build. Do not edit.\n#pragma once\n#define LITHOKRAFT_ALPHA_VERSION \"Alpha ${_v}\"\n#define LITHOKRAFT_ALPHA_FIELDS ${a}, ${b}, ${c}, ${d}\n")
file(RENAME "${HEADER}.tmp" "${HEADER}")
message(STATUS "LithoKraft build counter: Alpha ${_v}")
